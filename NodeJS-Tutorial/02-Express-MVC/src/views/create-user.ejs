<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create User</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container py-4" style="max-width: 950px;">
        <h1 class="fw-bold mb-4">Create a user:</h1>

        <form action="/handle-create-user" method="POST">
            <div class="mb-4">
                <label for="name" class="form-label fs-4">
                    Name:
                </label>

                <input type="text" class="form-control form-control-lg" id="name" name="name" required>
            </div>

            <div class="mb-4">
                <label for="email" class="form-label fs-4">
                    Email:
                </label>

                <input type="email" class="form-control form-control-lg" id="email" name="email" required>
            </div>

            <div class="mb-4">
                <label for="address" class="form-label fs-4">
                    Address:
                </label>

                <textarea class="form-control" id="address" name="address" rows="3"></textarea>
            </div>

            <button type="submit" class="btn btn-warning btn-lg">
                Submit
            </button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>