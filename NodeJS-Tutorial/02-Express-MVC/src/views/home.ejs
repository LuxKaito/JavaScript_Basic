<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>List Users</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container-fluid px-4 py-4">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
            <h1 class="fw-bold mb-0">List Users:</h1>

            <a href="/create-user" class="btn btn-warning">
                Create a new user
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (users && users.length > 0) { %>
                        <% users.forEach((user) => { %>
                            <tr>
                                <td><%= user.id %></td>
                                <td><%= user.name %></td>
                                <td><%= user.email %></td>
                                <td><%= user.address %></td>

                                <td>
                                    <a href="/users/<%= user.id %>" class="btn btn-warning btn-sm me-1">
                                        View
                                    </a>

                                    <a href="/update-user/<%= user.id %>" class="btn btn-primary btn-sm me-1">
                                        Edit
                                    </a>

                                    <form action="/handle-delete-user/<%= user.id %>" method="post" class="d-inline"
                                        onsubmit="return confirm('Ban co chac muon xoa user nay?')">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center">
                                Khong co nguoi dung
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
