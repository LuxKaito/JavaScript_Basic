{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}